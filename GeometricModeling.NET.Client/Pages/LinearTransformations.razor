@page "/linearTransforms"
@rendermode InteractiveWebAssembly

<div class="container-row">
    <div class="container-canvas border" @oncontextmenu:preventDefault="true" @oncontextmenu="@(e => { })">

        <SKCanvasView @ref="skiaView"
                      OnPaintSurface="OnPaintSurface"
                      IgnorePixelScaling="true" 
                      EnableRenderLoop="true"
                      @onpointerdown="OnPointerDown"
                      @onpointermove="OnPointerMove"
                      @onwheel="OnWheel" :preventDefault="true" />

    </div>
    <div class="container-grid">
        <div class="item1 form">
            <form>
                <fieldset>
                    <legend>Сітка</legend>
                    <div>
                        <label>Показати сітку</label>
                        <input type="checkbox" name="grid" @bind="@activeGrid"/>
                    </div>
                    <div>
                        <input type="number" name="name" step="25" min="25" @bind="@gridStep" @bind:event="oninput" @bind:after="GetGrid" />
                    </div>
                </fieldset>
            </form>
        </div>
        <div class="item2 form">
            <form>
                <fieldset>
                    <legend>Контур</legend>
                    <div>
                    <label>Колір контуру</label>
                        <input type="color" name="contourColor" @oninput="OnColorChanged" />
                    </div>
                </fieldset>
            </form>
        </div>
    </div>
</div>

@code {
    
}
