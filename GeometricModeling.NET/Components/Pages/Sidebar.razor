@rendermode InteractiveServer

<div class="sidebar @closedClass"> @*rename aside?*@
    <div class="top-row @closedClass">
        <a class="navbar-brand @closedClass" href="">Geometric Modeling</a>
        @if (isSidebarOpen)
        {
            <i class="bi bi-arrow-left-square closebtn" @onclick="ToggleNavMenu" aria-hidden="true"></i>
        }
        else
        {
            <i class="bi bi-list openbtn" @onclick="ToggleNavMenu" aria-hidden="true"></i>
        }
    </div>
    <nav>
        <div class="nav-item">
            <NavLink class="@($"nav-link {closedClass}")" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill" aria-hidden="true"></i>
                <span class="nav-link-text">Home</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="@($"nav-link {closedClass}")" href="raster">
                <i class="bi bi-circle-square" aria-hidden="true"></i>
                <span class="nav-link-text">Skia test</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="@($"nav-link {closedClass}")" href="linearTransforms">
                <i class="bi bi-square-fill" aria-hidden="true"></i>
                <span class="nav-link-text">Linear Transforms</span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool isSidebarOpen = true;
    private string? closedClass => isSidebarOpen ? null : "closed";
  
    private void ToggleNavMenu()
    {
        isSidebarOpen = !isSidebarOpen;
    }
}