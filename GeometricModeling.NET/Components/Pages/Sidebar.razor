@rendermode InteractiveServer

<div class="sidebar @_closedClass"> @*rename aside?*@
    <div class="top-row @_closedClass">
        <a class="navbar-brand @_closedClass" href="">Geometric Modeling</a>
        @if (_isSidebarOpen)
        {
            <i class="bi bi-arrow-left-square closebtn" @onclick="ToggleNavMenu" aria-hidden="true"></i>
        }
        else
        {
            <i class="bi bi-list openbtn" @onclick="ToggleNavMenu" aria-hidden="true"></i>
        }
    </div>
    <nav>
        <div class="nav-item">
            <NavLink class="@($"nav-link {_closedClass}")" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill" aria-hidden="true"></i>
                <span class="nav-link-text">Home</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="@($"nav-link {_closedClass}")" href="raster">
                <i class="bi bi-circle-square" aria-hidden="true"></i>
                <span class="nav-link-text">Skia test</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="@($"nav-link {_closedClass}")" href="linearTransforms">
                <i class="bi bi-square-fill" aria-hidden="true"></i>
                <span class="nav-link-text">Linear Transforms</span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool _isSidebarOpen = true;
    private string? _closedClass => _isSidebarOpen ? null : "closed";
  
    private void ToggleNavMenu()
    {
        _isSidebarOpen = !_isSidebarOpen;
    }
}